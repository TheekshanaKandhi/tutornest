# TutorNest environment variable template.
# Copy this file to the environment used by the deployment platform.

# Frontend build-time configuration
VITE_SITE_URL="https://tutornest.in"
VITE_API_BASE_URL="https://api.tutornest.in"
VITE_APP_ENV="production"

# Active Node/Express server configuration
PORT=3000
NODE_ENV="production"
CORS_ALLOWED_ORIGINS="https://tutornest.in,https://www.tutornest.in"
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/tutornest?sslmode=require"

# Required only for first production initialization
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# Development fixture controls; keep false/unset in production
SEED_USER_PASSWORD=""
SEED_DEMO_DATA="false"

# Optional server integrations
GEMINI_API_KEY=""
APP_URL="https://tutornest.in"
